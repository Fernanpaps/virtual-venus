---
const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} | Virtual Venus Blog</title>
	</head>
	<body>
		<h1>{title}</h1>
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}

	body {
		font-family: sans-serif;
		padding: 1rem 2rem;
		max-width: 800px;
		margin: 0 auto;
		color: #222;
	}

	nav {
		margin-bottom: 1.5rem;
	}

	nav a {
		color: #333;
		text-decoration: none;
		margin-right: 0.5rem;
	}

	nav a:hover {
		text-decoration: underline;
	}

	h1 {
		color: purple;
		font-size: 2.5rem;
	}
</style>
