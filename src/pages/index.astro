---
import BaseLayout from '../layouts/BaseLayout.astro';
import Greeting from '../components/Greeting';

const pageTitle = '¡Bienvenido a mi blog, soy Fernando!';
---

<BaseLayout pageTitle={pageTitle}>
	<p>Este es mi blog personal hecho con Astro, como práctica del curso.</p>
	<Greeting client:load messages={['Hola', 'Hi', 'Qué onda', 'Bonjour']} />
</BaseLayout>
